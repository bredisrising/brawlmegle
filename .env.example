# Input source for the player tracked on this machine: "mock" or "camera". Also overridable with ?input=camera
VITE_INPUT=mock
# Pose tracking: lite = lowest latency, full = more accurate in difficult conditions.
VITE_POSE_MODEL=lite
# One player per camera. Use 2 only for a deliberately shared camera.
VITE_POSE_COUNT=1
# Forge server (proxies OpenAI image + image-to-3D). Empty = use mocks.
VITE_FORGE_API=
# AWS signaling server (WebSocket) that brokers the P2P handshake
VITE_SIGNAL_URL=
# Optional TURN server for when venue Wi-Fi blocks direct P2P, e.g. turn:signal.example.com:3478
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
